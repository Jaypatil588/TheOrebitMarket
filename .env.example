# ── Backend (Go) ──────────────────────────────────────────────────────────────

# Gemini API key — get from https://aistudio.google.com/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string
# Neon:      postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase:  postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
# Railway:   postgresql://postgres:pass@containers-us-west-xxx.railway.app:5432/railway
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Set these in Vercel dashboard or frontend/.env.local for local dev

# HTTP URL of the Go backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# WebSocket URL of the Go backend
NEXT_PUBLIC_WS_URL=ws://localhost:8080
